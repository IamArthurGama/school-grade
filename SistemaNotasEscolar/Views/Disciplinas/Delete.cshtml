@model SistemaNotasEscolar.Models.Disciplina

@{
    ViewData["Title"] = "Excluir disciplina";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-0">Excluir disciplina</h1>
</div>

<div class="alert alert-warning mb-4">
    <i data-lucide="triangle-alert"></i>
    Confirme a exclusão da disciplina abaixo. Essa ação não pode ser desfeita.
</div>

<div class="col-md-6">
    <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 20px;">
        <dl class="row mb-0">
            <dt class="col-sm-3 mb-0">Nome</dt>
            <dd class="col-sm-9 mb-0">@Model.Nome</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i data-lucide="trash-2"></i>
                Excluir
            </button>
            <a class="btn btn-secondary" asp-action="Index">
                <i data-lucide="arrow-left"></i>
                Voltar
            </a>
        </div>
    </form>
</div>
