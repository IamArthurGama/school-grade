@model SistemaNotasEscolar.Models.Aluno

@{
    ViewData["Title"] = "Excluir aluno";
}

<h1 class="h3 mb-3">Excluir aluno</h1>

<div class="alert alert-warning">Confirme a exclusão do aluno abaixo.</div>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Matrícula</dt>
    <dd class="col-sm-10">@Model.Matricula</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
