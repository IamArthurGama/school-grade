@model SistemaNotasEscolar.Models.Aluno

@{
    ViewData["Title"] = "Editar aluno";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-0">Editar aluno</h1>
</div>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger" style="font-size: 12px;"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Matricula" class="form-label">Matrícula</label>
        <input asp-for="Matricula" class="form-control" />
        <span asp-validation-for="Matricula" class="text-danger" style="font-size: 12px;"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Salvar
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i data-lucide="arrow-left"></i>
            Voltar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
