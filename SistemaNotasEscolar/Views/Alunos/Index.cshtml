@model IEnumerable<SistemaNotasEscolar.Models.Aluno>

@{
    ViewData["Title"] = "Alunos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Alunos</h1>
    <a class="btn btn-primary" asp-action="Create">Novo aluno</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Matrícula</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var aluno in Model)
        {
            <tr>
                <td>@aluno.Nome</td>
                <td>@aluno.Matricula</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@aluno.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@aluno.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
