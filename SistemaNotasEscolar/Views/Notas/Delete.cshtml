@model SistemaNotasEscolar.Models.Nota

@{
    ViewData["Title"] = "Excluir nota";
}

<h1 class="h3 mb-3">Excluir nota</h1>

<div class="alert alert-warning">Confirme a exclusão da nota abaixo.</div>

<dl class="row">
    <dt class="col-sm-2">Aluno</dt>
    <dd class="col-sm-10">@Model.Aluno.Nome</dd>
    <dt class="col-sm-2">Disciplina</dt>
    <dd class="col-sm-10">@Model.Disciplina.Nome</dd>
    <dt class="col-sm-2">Nota</dt>
    <dd class="col-sm-10">@Model.Valor.ToString("0.##")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>
