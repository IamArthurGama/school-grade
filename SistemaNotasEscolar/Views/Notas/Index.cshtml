@model IEnumerable<SistemaNotasEscolar.Models.Nota>

@{
    ViewData["Title"] = "Notas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notas</h1>
    <a class="btn btn-primary" asp-action="Create">Nova nota</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Aluno</th>
            <th>Matrícula</th>
            <th>Disciplina</th>
            <th>Nota</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nota in Model)
        {
            <tr>
                <td>@nota.Aluno.Nome</td>
                <td>@nota.Aluno.Matricula</td>
                <td>@nota.Disciplina.Nome</td>
                <td>@nota.Valor.ToString("0.##")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@nota.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@nota.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
