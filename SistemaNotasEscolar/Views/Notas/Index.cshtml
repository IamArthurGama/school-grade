@model IEnumerable<SistemaNotasEscolar.Models.Nota>
@using System.Linq

@{
    ViewData["Title"] = "Notas";
}

<div class="page-header">
    <h1 class="h3 mb-0">Notas</h1>
    <a class="btn btn-primary" asp-action="Create">
        <i data-lucide="plus-circle"></i>
        Nova nota
    </a>
</div>

<div class="table-wrapper">
    @if (Model != null && Model.Any())
    {
        var grupos = Model.GroupBy(n => n.Disciplina.Nome).OrderBy(g => g.Key);
        foreach (var grupo in grupos)
        {
            <h5 class="mt-4">@grupo.Key</h5>
            <table class="table table-striped align-middle mb-4">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Matrícula</th>
                        <th>Nota</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nota in grupo.OrderBy(n => n.Aluno.Nome))
                    {
                        <tr>
                            <td>@nota.Aluno.Nome</td>
                            <td>@nota.Aluno.Matricula</td>
                            <td>@nota.Valor.ToString("0.##")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@nota.Id">
                                    <i data-lucide="pencil"></i>
                                    Editar
                                </a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@nota.Id">
                                    <i data-lucide="trash-2"></i>
                                    Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else
    {
        <div class="alert alert-info">Nenhuma nota encontrada.</div>
    }
</div>
