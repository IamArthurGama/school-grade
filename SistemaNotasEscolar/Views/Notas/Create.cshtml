@model SistemaNotasEscolar.Models.Nota

@{
    ViewData["Title"] = "Nova nota";
}

<h1 class="h3 mb-3">Nova nota</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="AlunoId" class="form-label">Aluno</label>
        <select asp-for="AlunoId" asp-items="ViewBag.AlunoId" class="form-select">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="AlunoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DisciplinaId" class="form-label">Disciplina</label>
        <select asp-for="DisciplinaId" asp-items="ViewBag.DisciplinaId" class="form-select">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="DisciplinaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" type="number" min="0" max="10" step="0.01" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
