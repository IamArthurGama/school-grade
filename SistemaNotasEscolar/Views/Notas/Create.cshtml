@model SistemaNotasEscolar.Models.Nota

@{
    ViewData["Title"] = "Nova nota";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-0">Nova nota</h1>
</div>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="AlunoId" class="form-label">Aluno</label>
        <select asp-for="AlunoId" asp-items="ViewBag.AlunoId" class="form-select">
            <option value="">Selecione um aluno</option>
        </select>
        <span asp-validation-for="AlunoId" class="text-danger" style="font-size: 12px;"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DisciplinaId" class="form-label">Disciplina</label>
        <select asp-for="DisciplinaId" asp-items="ViewBag.DisciplinaId" class="form-select">
            <option value="">Selecione uma disciplina</option>
        </select>
        <span asp-validation-for="DisciplinaId" class="text-danger" style="font-size: 12px;"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" type="number" min="0" max="10" step="0.01" placeholder="0.00" />
        <span asp-validation-for="Valor" class="text-danger" style="font-size: 12px;"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            Salvar
        </button>
        <a class="btn btn-secondary" asp-action="Index">
            <i data-lucide="arrow-left"></i>
            Voltar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
